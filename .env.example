# ==========================================
# PhantomShell Configuration Environment
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=127.0.0.1,localhost

# Local Storage
DATABASE_URL=sqlite:///./phantomshell.db
MAX_EVENT_RETENTION=2000

# Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini
OLLAMA_CONNECT_TIMEOUT=5.0
OLLAMA_REQUEST_TIMEOUT=30.0
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=512

# Monitored Workspace Defaults
# Relative to repository root or absolute path
DEFAULT_MONITORED_DIR=./demo/sandbox

# Deterministic Detection Engine Thresholds
FILE_BURST_THRESHOLD=10
FILE_BURST_WINDOW_SECONDS=5
FAILED_OP_THRESHOLD=3
FAILED_OP_WINDOW_SECONDS=15
SUSPICIOUS_PROCESS_NAMES=mimikatz.exe,nc.exe,ncat.exe,netcat.exe,psexec.exe,procdump.exe,lazagne.exe,bloodhound.exe
SENSITIVE_PATHS=.ssh,.aws,.gnupg,.env,id_rsa,id_ed25519,credentials,shadow,passwd
